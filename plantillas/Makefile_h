# @brief The Makefile compiles three files into an executable:
# program.cc, program_func.cc and program.h
#
# Use 'make clean' to delete .o files, executables or other type of trash

CC=g++
CFLAGS=-O0 -Wall
DEPS = program.h
OBJ = program.o program_func.o

all: program

%.o: %.cc $(DEPS)
	$(CC) -c -o $@ $< $(CFLAGS)

program: $(OBJ)
	$(CC) -o $@ $^ $(CFLAGS)

.PHONY: all clean

clean:
	rm -f program *.o *~ a.out
	find . -name '*~' -exec rm {} \;
